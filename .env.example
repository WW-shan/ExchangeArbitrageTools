# Local environment template. Copy to .env.live-test (ignored by Git).
# Never put exchange API keys or ARB_SECRET_STORE_KEY in this file.
# Exchange credentials belong in the encrypted store; see config/api-keys.example.json.
# Copy the example to data/api-keys.json, fill what you have, then import with --merge --skip-empty.
ARB_CONFIG=config/live-test.toml
ARB_SECRET_STORE_PATH=data/secrets.enc.json
ARB_SOCKS_PROXY=socks5://127.0.0.1:10808
# scripts/load-env.ps1 loads data/master-key.dpapi when ARB_SECRET_STORE_KEY is unset.

# DEX quote provider keys are optional and are read directly from the environment.
# ZEROX_API_KEY=
# ONEINCH_API_KEY=
BSC_RPC_URL=https://bsc-rpc.publicnode.com
