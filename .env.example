# Local credentials only. Never commit this file.
GATEIO_API_KEY=
GATEIO_SECRET=
MEXC_API_KEY=
MEXC_SECRET=
WEEX_API_KEY=
WEEX_SECRET=
HOTCOIN_API_KEY=
HOTCOIN_SECRET=
ZEROX_API_KEY=
ONEINCH_API_KEY=
BSC_RPC_URL=https://bsc-rpc.publicnode.com

# Encrypted credential store and optional database override.
ARB_SECRET_STORE_PATH=data/secrets.enc.json
# Set ARB_SECRET_STORE_KEY outside this file, for example in an OS keychain.

# Optional forward proxy for CCXT REST requests (for example a local VPN client).
# ARB_HTTPS_PROXY=http://127.0.0.1:10808
# Prefer SOCKS5 for both REST and WebSocket; it was much lower latency in tests.
# ARB_SOCKS_PROXY=socks5://127.0.0.1:10808
# For providers using global fetch, also run Node with: NODE_OPTIONS=--use-env-proxy
