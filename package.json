{
  "name": "exchange-arbitrage-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cost-aware CEX, triangular, and BSC arbitrage scanner with safe paper execution",
  "engines": {
    "node": ">=22.5"
  },
  "workspaces": [
    "packages/core",
    "packages/storage",
    "packages/venues/cex",
    "packages/venues/bsc",
    "apps/scanner",
    "apps/executor",
    "apps/dashboard"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json --pretty false",
    "test:types": "tsc -p tsconfig.tests.json --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "npm run typecheck && npm run test:types && npm run format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "backtest": "tsx scripts/backtest.ts",
    "backtest:history": "tsx scripts/backtest-history.ts",
    "capture:fixture": "tsx scripts/capture-fixture.ts",
    "replay": "tsx scripts/replay.ts",
    "verify:tokens": "tsx scripts/verify-tokens.ts",
    "scanner": "tsx apps/scanner/src/main.ts",
    "api": "tsx apps/dashboard/src/main.ts",
    "executor": "tsx apps/executor/src/main.ts",
    "rotation:auto": "tsx apps/executor/src/main.ts --auto",
    "rotation:halt": "tsx apps/executor/src/halt-cli.ts",
    "rotation:release": "tsx apps/executor/src/release-cli.ts",
    "rotation:watchdog": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/watch-rotation.ps1",
    "rotation:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-rotation.ps1",
    "rotation:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-rotation.ps1",
    "rotation:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rotation-status.ps1",
    "rotation:task:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-rotation-task.ps1",
    "rotation:autostart:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-rotation-autostart.ps1",
    "rotation:autostart:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-rotation-autostart.ps1",
    "seed:rotation": "tsx scripts/seed-rotation.ts",
    "rotation:rank": "tsx scripts/rank-rotation-history.ts",
    "executor:secrets": "tsx apps/executor/src/secrets-cli.ts",
    "executor:secrets:import": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/import-credentials.ps1",
    "executor:venue": "tsx apps/executor/src/venue-cli.ts",
    "executor:balances": "tsx apps/executor/src/balance-cli.ts",
    "account:state": "tsx apps/executor/src/account-state-cli.ts",
    "check": "npm run lint && npm run test && npm run backtest",
    "probe:venues": "tsx scripts/probe-venues.ts",
    "live:readiness": "tsx scripts/live-readiness.ts",
    "fees:fetch": "tsx scripts/fetch-fees.ts",
    "analyze:feed": "tsx scripts/analyze-feed.ts",
    "replay:feed": "tsx scripts/replay-feed.ts",
    "rebalance:plan": "tsx scripts/rebalance-plan.ts",
    "rebalance:execute": "tsx scripts/rebalance-execute.ts",
    "routes:stats": "tsx scripts/route-stats.ts",
    "smoke:s1": "tsx scripts/smoke-s1.ts",
    "smoke:discovery": "tsx scripts/smoke-s1.ts --venues gateio,hotcoin --universe top_volume --max-bases 30 --min-24h-volume 100000 --cycles 5 --warmup-ms 10000 --interval-ms 3000 --taker-bps 10 --maker-bps 2 --min-net-profit-bps 5 --min-profit-usd 0.01 --safety-buffer-bps 2 --min-sizing-notional 15",
    "scan:longtail": "tsx scripts/scan-longtail.ts --config config/longtail.toml",
    "scan:longtail:test": "tsx scripts/scan-longtail.ts --config config/longtail.toml --bases INC,TBK,HTX --max-bases 10 --detail 10 --out data/longtail-smoke.json",
    "watch:s1": "tsx scripts/scan-longtail.ts --config config/longtail.toml --watchlist config/s1-watchlist.json --min-volume 1 --max-volume 5000000 --max-book-candidates 20 --top 20 --detail 6 --probes 5,10,15,20 --min-notional 15 --max-notional 20",
    "track:spread": "tsx scripts/track-spread.ts --config config/longtail.toml --base TBK --duration-ms 180000 --interval-ms 3000",
    "probe:ioc-fok": "tsx scripts/probe-private-fok.ts",
    "execution:reconcile": "tsx apps/executor/src/reconcile-cli.ts",
    "executor:secrets:bitget": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/import-bitget-credential.ps1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^4.0.9",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.9"
  },
  "dependencies": {
    "http-proxy-agent": "^9.1.0",
    "https-proxy-agent": "^9.1.0",
    "protobufjs": "^7.6.6",
    "socks-proxy-agent": "^10.1.0"
  }
}
